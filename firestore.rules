rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dominicmarkude@gmail.com' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPost(data) {
      return data.keys().hasAll(['title', 'excerpt', 'category', 'date', 'image', 'content']) &&
             data.keys().size() >= 6 && data.keys().size() <= 9 &&
             data.title is string && data.title.size() <= 200 &&
             data.excerpt is string && data.excerpt.size() <= 500 &&
             data.category is string && data.category.size() <= 100 &&
             data.date is string && data.date.size() <= 100 &&
             data.image is string && data.image.size() <= 500 &&
             data.content is string && data.content.size() <= 50000 &&
             (data.keys().hasAny(['externalLink']) == false || (data.externalLink is string && data.externalLink.size() <= 500)) &&
             (data.keys().hasAny(['createdAt']) == false || data.createdAt is timestamp) &&
             (data.keys().hasAny(['updatedAt']) == false || data.updatedAt is timestamp);
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // Only server-side or console can add admins
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(postId) && isValidPost(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(postId) && isValidPost(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(postId);
    }
  }
}
